@using CRUDwithIdentity.ViewModels;
@model LoginViewModel;

@{
    ViewData["Title"] = "Login";
}

        <h2 class="text-center mb-4">Login</h2>
        <form asp-action="Login" method="post">
        <input type="hidden" asp-for="ReturnUrl"/>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Email" ></label>
                <input asp-for="Email" />
                <span asp-validation-for="Email"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" ></label>
                <input asp-for="Password"  />
                <span asp-validation-for="Password" ></span>
            </div>
            <div>
                <a asp-controller="Account" asp-action="VerifyEmail" >
                    Forgot password?
                </a>
            </div>
            <div class="form-check mb-3">
        <label> 
                    <input asp-for="RememberMe" />
                    @Html.DisplayNameFor(a=> a.RememberMe)
        </label>
            </div>
            <input type="submit" value="Login"  />
            <p >
                Don't have an account? <a asp-controller="Account" asp-action="Register" >Register</a>
            </p>
            <div >
                <a asp-controller="Home" asp-action="Index" >Back</a>
            </div>
        </form>
 

@*Client side validation*@
@section Scripts{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}