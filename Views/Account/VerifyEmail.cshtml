@model CRUDwithIdentity.ViewModels.VerifyEmailViewModel

@{
    ViewData["Title"] = "Verify Email";
}

<div>
    <h2 class="text-center mb-4">Verify Email</h2>
    <form asp-action="VerifyEmail" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div>
            <label asp-for="Email"></label>
            <input asp-for="Email"/>
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <input type="submit" value="Verify" />
        <div>
            <a asp-controller="Home" asp-action="Index">Back</a>
        </div>
    </form>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}