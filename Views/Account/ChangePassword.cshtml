@model CRUDwithIdentity.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
}

<div>
    <h2 class="text-center mb-4">Change Password</h2>
    <form asp-action="ChangePassword" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div>
            <label asp-for="Email"></label>
            <input asp-for="Email" readonly/>
        </div>
            
        <div>
            <label asp-for="NewPassword"></label>
            <input asp-for="NewPassword"/>
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>

        <div>
            <label asp-for="ConfirmNewPassword"></label>
            <input asp-for="ConfirmNewPassword" />
            <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
        </div>

        <input type="submit" value="Submit"/>
        <div>
            <a asp-controller="Account" asp-action="VerifyEmail" class="text-decoration-none mt-3">Back</a>
        </div>
    </form>
</div> 